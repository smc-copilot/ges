{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ges.project.v2",
  "title": "GES Project Desired State v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "profile", "agents", "capabilities", "resolution", "engineering_stack"],
  "properties": {
    "schema": { "const": "ges.project.v2" },
    "profile": { "type": "string" },
    "agents": { "type": "array", "items": { "type": "string" } },
    "capabilities": {
      "type": "object",
      "required": ["requested"],
      "properties": {
        "requested": { "type": "array", "items": { "type": "string" } },
        "explicitly_disabled": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resolution": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "const": "explicit" }
      }
    },
    "engineering_stack": { "type": "object" }
  }
}
