{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ges.work.v2",
  "title": "GES Work Declaration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "title",
    "status",
    "owner",
    "risk",
    "policy",
    "artifacts",
    "capabilities",
    "execution",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema": { "const": "ges.work.v2" },
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]{2,63}$" },
    "kind": { "const": "FEATURE" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["OPEN", "CLOSED"] },
    "owner": { "type": "string", "minLength": 1 },
    "risk": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
    "policy": { "const": "default-v1" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "pointer", "digest"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["SPEC", "PLAN"] },
          "pointer": { "type": "string", "pattern": "^repo://" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "host"],
      "properties": {
        "profile": { "const": "ges-native" },
        "host": { "type": "string", "enum": ["cursor", "codex", "hermes"] }
      }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  }
}
